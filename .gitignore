!/reports/inference/bootstrap.csv
!/reports/inference/ordering.csv
!/reports/inference/deflated.csv
!/reports/inference/cpcv.csv
# ...and the caches stay ignored explicitly: a stale one would silently
# produce numbers for a strategy that has since changed.
/reports/inference/daily_returns*.csv.gz
# matched-risk round (R-31). Small, and docs/VALIDATION.md cites the rows
# directly - the frozen exposures in particular are the pre-registration's
# receipt, so they belong in git rather than in a regenerable cache.
!/reports/matched_risk/
!/reports/matched_risk/*.csv
!/reports/matched_risk/*.json
!/reports/matched_risk/*.txt
# the de-levered-benchmark round (R-33). Same reasoning as matched_risk:
# the frozen exposures are the pre-registration's receipt.
!/reports/matched_hold/
!/reports/matched_hold/*.csv
!/reports/matched_hold/*.json
!/reports/matched_hold/*.txt
!/reports/matched_hold/*.png
# the ungated-control round (R-32): its frontier chart is the picture of
# what a gate is worth at matched risk, and its window resample is the
# evidence behind that claim
!/reports/gate_control/
!/reports/gate_control/*.png
!/reports/gate_control/*.csv
