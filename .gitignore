!/reports/inference/ordering.csv
!/reports/inference/deflated.csv
!/reports/inference/cpcv.csv
# ...and the caches stay ignored explicitly: a stale one would silently
# produce numbers for a strategy that has since changed.
/reports/inference/daily_returns*.csv.gz
