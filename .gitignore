__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.venv/
venv/
# transient agent working directories, not project content
/.claude/worktrees/
/data/*
*.csv
*.parquet
!/data/btcusd_spot_5m.csv.gz
# real Binance BTCUSDT perp funding, charged as a first-class cost
!/data/btcusdt_perp_funding_8h.csv.gz
# Deribit BTC-PERPETUAL funding, 2020-2026; covers the post-2023 gap the
# Binance series leaves (Binance is unreachable from these sessions)
!/data/btcusdt_deribit_perp_funding_8h.csv.gz
# Bitfinex ETH/BTC 2016-2019, for the cross-asset falsification test
!/data/ethusd_bitfinex_5m.csv.gz
!/data/btcusd_bitfinex_5m.csv.gz
!/data/btcusdt_perp_5m.csv
!/data/btcusdt_spot_aligned_5m.csv
/reports/*
!/reports/comparison.md
!/reports/comparison.csv
# stress-test outputs are committed: the charts are the deliverable
!/reports/stress/
!/reports/stress/*.png
!/reports/stress/*.csv
# inference results are committed - they are what the README's warning cites.
# The daily-return caches under it are regenerable intermediates and stay out.
!/reports/inference/
!/reports/inference/*.png
!/reports/inference/bootstrap.csv
!/reports/inference/ordering.csv
!/reports/inference/deflated.csv
!/reports/inference/cpcv.csv
# ...and the caches stay ignored explicitly: a stale one would silently
# produce numbers for a strategy that has since changed.
/reports/inference/daily_returns*.csv.gz
# matched-risk round (R-31). Small, and docs/VALIDATION.md cites the rows
# directly - the frozen exposures in particular are the pre-registration's
# receipt, so they belong in git rather than in a regenerable cache.
!/reports/matched_risk/
!/reports/matched_risk/*.csv
!/reports/matched_risk/*.json
!/reports/matched_risk/*.txt
# the de-levered-benchmark round (R-33). Same reasoning as matched_risk:
# the frozen exposures are the pre-registration's receipt.
!/reports/matched_hold/
!/reports/matched_hold/*.csv
!/reports/matched_hold/*.json
!/reports/matched_hold/*.txt
!/reports/matched_hold/*.png
# the ungated-control round (R-32): its frontier chart is the picture of
# what a gate is worth at matched risk, and its window resample is the
# evidence behind that claim
!/reports/gate_control/
!/reports/gate_control/*.png
!/reports/gate_control/*.csv
# a curated set of run charts is committed so the README renders on GitHub;
# the other ~90 regenerate with `tradebot run`
!/reports/charts/
/reports/charts/*
!/reports/charts/_all__spot__1000_part1.png
!/reports/charts/_all__futures_5x__1000_part1.png
!/reports/charts/kelly_regime_v4__futures_5x__1000.png
!/reports/charts/kelly_regime_v4__spot__1000.png
!/reports/charts/kelly_regime__futures_5x__1000.png
!/reports/charts/kelly_regime__spot__1000.png
!/reports/charts/champions_council__futures_5x__1000.png
!/reports/charts/buy_and_hold__spot__1000.png
