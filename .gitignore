!/reports/r59_conservative/
!/reports/r59_conservative/*.csv
!/reports/r59_novel/
!/reports/r59_novel/*.csv
# R-60 (B-26): per-cell numbers behind both branches' reports, same
# reasoning as r59_conservative/r59_novel above.
!/reports/r60_conservative/
!/reports/r60_conservative/*.csv
!/reports/r60_novel/
!/reports/r60_novel/*.csv
# R-64 (the holding-period axis): both branches' frontier rows plus the
# operator's prices-only decay curve. Same reasoning as r60_* above -- the
# per-cell numbers are the receipt that the pre-registered rules were read
# in the order the ledger claims.
!/reports/r65_holding_period/
!/reports/r65_holding_period/*.csv
# R-68 (the band-shape axis): both branches' frontier rows plus the operator's
# prices-only stopping-premium and grace-cost measurements. Same reasoning as
# r65_holding_period above -- the per-cell numbers are the receipt that the
# pre-registered rules were read in the order the ledger claims.
!/reports/r68_band/
!/reports/r68_band/*.csv
# R-69 (B-37, the entry-only gate stripped of R-65's buffer/hold_days): both
# branches' identity/self-check/decision-cell/scramble CSVs. Same reasoning
# as r68_band above -- the per-cell numbers are the receipt that the
# pre-registered rules were read in the order the ledger claims.
!/reports/r69_entry_only_raw/
!/reports/r69_entry_only_raw/*.csv
